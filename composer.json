{
	"name": "youthweb/urllinker",
	"description": "Autolink URLs in text or html",
	"type": "library",
	"license": "GPL-3.0-or-later",
	"homepage": "https://github.com/Art4/urllinker",
	"authors": [
		{
			"name": "Søren Løvborg",
			"role": "Developer"
		},
		{
			"name": "Dawid Nowak",
			"email": "code@dnowak.pl",
			"role": "Developer"
		}
	],
	"require": {
		"php": "^8.2"
	},
	"require-dev": {
		"friendsofphp/php-cs-fixer": "^3.95",
		"phpmd/phpmd": "^3.0",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.3.2",
		"phpstan/phpstan-deprecation-rules": "^2.0",
		"phpstan/phpstan-phpunit": "^2.0",
		"phpstan/phpstan-strict-rules": "^2.0",
		"phpunit/phpunit": "^11.5 || ^12.5 || ^13.4",
		"rector/rector": "^2.1"
	},
	"autoload": {
		"files": [
			"src/compat.php"
		],
		"psr-4": {
			"Art4\\UrlLinker\\": "src"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Art4\\UrlLinker\\Tests\\": "tests"
		}
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"phpstan/extension-installer": true
		}
	},
	"scripts": {
		"codestyle": "vendor/bin/php-cs-fixer fix",
		"coverage": "vendor/bin/phpunit --coverage-html=\"build/code-coverage\"",
		"coverage-check": [
			"mkdir -p build && vendor/bin/phpunit --coverage-clover=\"build/coverage.xml\"",
			"php scripts/check-coverage.php"
		],
		"phpmd": "vendor/bin/phpmd analyze src tests --ruleset phpmd.xml",
		"phpstan": "vendor/bin/phpstan analyze --configuration phpstan.neon",
		"phpunit": "vendor/bin/phpunit",
		"rector": "vendor/bin/rector process --dry-run",
		"refactor": [
			"vendor/bin/rector process",
			"@codestyle"
		],
		"qa": [
			"@phpunit",
			"@phpstan",
			"@phpmd",
			"@codestyle --dry-run --diff",
			"@coverage-check"
		]
	}
}
